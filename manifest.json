{
    "manifest_version": 3,
    "name": "Librus average grade calculator",
    "version": "1.0",
    "permissions":["activeTab"],
    "content_scripts": [
        {
            "matches": ["https://synergia.librus.pl/*"],
            "js": ["content.js"],
            //so the script will run after the page is fully loaded, otherwise it may not work properly
            "run_at": "document_end"
        }
    ],
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }

}